# Store the deployed value in /etc/zeuszs-updater.env with mode 0600.
ZEUSZS_UPDATER_TOKEN=replace-with-a-long-random-token

# Defaults shown for the test server deployment.
ZEUSZS_UPDATER_SOCKET=/run/zeuszs-updater/updater.sock
ZEUSZS_UPDATER_RELEASE_ROOT=/opt/zeuszs/releases
ZEUSZS_UPDATER_BACKUP_ROOT=/opt/zeuszs/backups
ZEUSZS_UPDATER_STATE_ROOT=/var/lib/zeuszs-updater
ZEUSZS_UPDATER_COMPOSE_DIR=/opt/new-api
ZEUSZS_UPDATER_COMPOSE_FILE=/opt/new-api/docker-compose.yml
ZEUSZS_UPDATER_COMPOSE_OVERRIDE_FILE=/opt/new-api/docker-compose.override.yml
ZEUSZS_UPDATER_DOCKER_BIN=/usr/bin/docker
ZEUSZS_UPDATER_DOCKER_ROOT=/var/lib/docker
ZEUSZS_UPDATER_APP_SERVICE=new-api
ZEUSZS_UPDATER_POSTGRES_CONTAINER=new-api-postgres
ZEUSZS_UPDATER_POSTGRES_USER=root
ZEUSZS_UPDATER_POSTGRES_DATABASE=new-api
ZEUSZS_UPDATER_HEALTH_URL=http://127.0.0.1:3000/api/status
ZEUSZS_UPDATER_BASE_IMAGE=debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
ZEUSZS_UPDATER_HEALTH_TIMEOUT=5m
ZEUSZS_UPDATER_POLL_INTERVAL=2s
ZEUSZS_UPDATER_UPDATE_TIMEOUT=15m
ZEUSZS_UPDATER_ROLLBACK_TIMEOUT=5m
ZEUSZS_UPDATER_MIN_FREE_BYTES=2147483648
